// Data model from backlog_iteracion_1_backend.md section 7.
// Prisma fields are English camelCase; tables and columns keep the backlog names.
//
// Not expressible in Prisma, added by hand to the `init` migration.sql (keep them
// if the migration is ever regenerated):
//   - partial unique index: one active fingerprint per student
//       CREATE UNIQUE INDEX "fingerprints_one_active_per_student"
//         ON "fingerprints" ("student_id") WHERE "activa";
//   - CHECK on schedules: exactly one of dia_semana / fecha is set.
//   - partial unique index: one active assignment per schedule and student
//       CREATE UNIQUE INDEX "schedule_students_one_active"
//         ON "schedule_students" ("schedule_id", "student_id") WHERE "valid_to" IS NULL;
//   - partial unique index: at most one active period
//       CREATE UNIQUE INDEX "periods_one_active" ON "periods" ((true)) WHERE "activo";
//   - CHECKs on periods (inicio <= fin) and service_exceptions (desde <= hasta).
//   - H11: `h11_schedule_validity_backfill` is data only (closes the open intervals
//     of inactive students using their first `student.deactivated` event; idempotent).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum EnrollmentStatus {
  pending
  in_progress
  done
  failed
  expired
  cancelled

  @@map("enrollment_status")
}

enum SessionStatus {
  abierta
  cerrada
  no_registrada

  @@map("session_status")
}

enum AttendanceSource {
  device
  manual
  // H12: reconstructed from the queue a reader kept while it had no connection.
  offline

  @@map("attendance_source")
}

enum CommandStatus {
  pending
  sent
  acked
  failed

  @@map("command_status")
}

enum ActorType {
  user
  system
  device

  @@map("actor_type")
}

enum PanelRole {
  asistente
  admin

  @@map("panel_role")
}

// H12: `local` alarms were sounded by the reader itself while offline.
enum AlarmOrigin {
  server
  local

  @@map("alarm_origin")
}

enum AlarmClosedBy {
  all_exited
  button
  cli
  timeout

  @@map("alarm_closed_by")
}

model Student {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document       String    @unique @map("documento")
  name           String    @map("nombre")
  // The student's degree ("carrera").
  program        String?   @map("programa")
  active         Boolean   @default(true) @map("activo")
  // Consent to the processing of biometric data (Ley 1581): version of the text
  // accepted, when and by which panel user (NULL = the system key or a
  // pre-existing student). `consented` is derived: consent_version IS NOT NULL.
  consentVersion String?   @map("consent_version")
  consentAt      DateTime? @map("consent_at") @db.Timestamptz()
  consentBy      String?   @map("consent_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  // Set when the personal data was erased (H11, Ley 1581); the row stays
  // anonymised so sessions and reports keep adding up.
  anonymizedAt   DateTime? @map("anonymized_at") @db.Timestamptz()
  importBatchId  String?   @map("import_batch_id") @db.Uuid
  // Short name for the reader screen (accents kept, up to DISPLAY_NAME_MAX). NULL = generated
  // from `name` when read.
  displayName    String?   @map("display_name")
  // Optional contact data (Ley 1581: data minimisation). Never logged, never
  // sent to the reader.
  email          String?   @map("correo")
  phone          String?   @map("telefono")

  fingerprints  Fingerprint[]
  enrollments   Enrollment[]
  schedules     ScheduleStudent[]
  sessions      AttendanceSession[]
  offlineEvents OfflineEvent[]
  consentUser   PanelUser?          @relation(fields: [consentBy], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?        @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([importBatchId])
  @@map("students")
}

// Academic period (H9). At most one is active (partial unique index in the
// migration) and their dates never overlap (checked by the service).
// CHECK (inicio <= fin) is added by hand in the migration.
model Period {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @map("nombre")
  startDate DateTime @map("inicio") @db.Date
  endDate   DateTime @map("fin") @db.Date
  active    Boolean  @default(false) @map("activo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  exceptions ServiceException[]
  schedules  Schedule[]

  @@map("periods")
}

// Days without service inside a period (holidays, breaks).
// CHECK (desde <= hasta) is added by hand in the migration.
model ServiceException {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId String   @map("period_id") @db.Uuid
  from     DateTime @map("desde") @db.Date
  to       DateTime @map("hasta") @db.Date
  reason   String   @map("motivo")

  period Period @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@map("service_exceptions")
}

// One row per CSV import. Only counts: the error report holds personal data
// and is never stored.
model ImportBatch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename  String   @map("archivo")
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("fecha") @db.Timestamptz()
  total     Int
  valid     Int      @map("validas")
  errors    Int      @map("con_error")

  user     PanelUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  students Student[]

  @@map("import_batches")
}

model Fingerprint {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  // Already encrypted (AES-256-GCM, tag appended); never plain.
  template   Bytes    @map("plantilla")
  iv         Bytes
  // At most one active per student: partial unique index in the migration.
  active     Boolean  @default(true) @map("activa")
  // Version of the encryption key that sealed `template` (H11); existing rows are 1.
  keyVersion Int      @default(1) @map("key_version")
  createdAt  DateTime @default(now()) @map("creada") @db.Timestamptz()

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slots   DeviceSlot[]

  @@index([studentId])
  @@index([keyVersion])
  @@map("fingerprints")
}

model Device {
  id               String    @id
  name             String?   @map("nombre")
  lastConnectedAt  DateTime? @map("ultima_conexion") @db.Timestamptz()
  firmwareVersion  String?   @map("version_firmware")
  // Reset to false on server start: no connection survives a restart.
  online           Boolean   @default(false) @map("en_linea")
  // Own token (H11): only the SHA-256 hex hash is stored. NULL with
  // `tokenRevokedAt` NULL = still on the shared DEVICE_TOKEN (transition);
  // NULL with `tokenRevokedAt` set = revoked, nothing is accepted.
  tokenHash        String?   @map("token_hash")
  tokenCreatedAt   DateTime? @map("token_created_at") @db.Timestamptz()
  tokenRevokedAt   DateTime? @map("token_revoked_at") @db.Timestamptz()
  // Offline alert (H11): since when it is offline and when it was alerted
  // (one alert per drop). Both cleared when it reconnects.
  offlineSince     DateTime? @map("offline_since") @db.Timestamptz()
  offlineAlertedAt DateTime? @map("offline_alerted_at") @db.Timestamptz()
  // H12: what the hello declared (empty = a v0 reader) and the last clock check
  // (device time minus server time, in seconds).
  capabilities     String[]  @default([])
  clockOffsetSec   Int?      @map("clock_offset_sec")
  clockCheckedAt   DateTime? @map("clock_checked_at") @db.Timestamptz()

  enrollments      Enrollment[]
  slots            DeviceSlot[]
  commands         DeviceCommand[]
  messages         ProcessedMessage[]
  offlineSnapshots OfflineSnapshot[]
  offlineEvents    OfflineEvent[]

  @@map("devices")
}

model Enrollment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  deviceId      String           @map("device_id")
  status        EnrollmentStatus @default(pending) @map("estado")
  expiresAt     DateTime         @map("expira") @db.Timestamptz()
  // Last enroll.progress step and the reason of a failure (device or validation).
  step          String?          @map("paso")
  failureReason String?          @map("motivo_fallo")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([deviceId, status])
  @@map("enrollments")
}

model DeviceSlot {
  deviceId      String  @map("device_id")
  slot          Int
  fingerprintId String? @map("fingerprint_id") @db.Uuid
  syncId        String? @map("sync_id")

  device      Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  fingerprint Fingerprint? @relation(fields: [fingerprintId], references: [id], onDelete: SetNull)

  @@id([deviceId, slot])
  @@index([fingerprintId])
  @@map("device_slots")
}

model Schedule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @map("nombre")
  // Exactly one of weekday / date is set (CHECK in the migration).
  weekday           Int?      @map("dia_semana")
  date              DateTime? @map("fecha") @db.Date
  startTime         DateTime  @map("inicio") @db.Time()
  endTime           DateTime  @map("fin") @db.Time()
  // Entry window overrides: minutes before startTime when entry opens and
  // before endTime when it closes. NULL = use ENTRY_OPEN_MINUTES / ENTRY_CLOSE_MINUTES.
  entryOpenMinutes  Int?      @map("margen_ingreso")
  entryCloseMinutes Int?      @map("margen_cierre_ingreso")
  // Recurring schedules created since H9 belong to a period; NULL for the
  // legacy ones and for one-off schedules. A period with schedules is not deleted.
  periodId          String?   @map("period_id") @db.Uuid

  period    Period?            @relation(fields: [periodId], references: [id], onDelete: Restrict)
  students  ScheduleStudent[]
  instances ScheduleInstance[]

  @@map("schedules")
}

// One row per validity interval of a student in a schedule: removing a student
// closes `validTo` instead of deleting, and assigning again opens a new row.
// At most one open row per pair (partial unique index in the migration).
model ScheduleStudent {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId String    @map("schedule_id") @db.Uuid
  studentId  String    @map("student_id") @db.Uuid
  validFrom  DateTime  @map("valid_from") @db.Timestamptz()
  // NULL = still assigned.
  validTo    DateTime? @map("valid_to") @db.Timestamptz()

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([scheduleId, validTo])
  @@index([studentId, validFrom])
  @@map("schedule_students")
}

model ScheduleInstance {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId  String    @map("schedule_id") @db.Uuid
  date        DateTime  @map("fecha") @db.Date
  startsAt    DateTime  @map("inicio") @db.Timestamptz()
  endsAt      DateTime  @map("fin") @db.Timestamptz()
  status      String    @default("scheduled") @map("estado")
  // Informative: when the generator created the row (NULL for older rows).
  generatedAt DateTime? @map("generated_at") @db.Timestamptz()

  schedule      Schedule            @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sessions      AttendanceSession[]
  alarms        AlarmEvent[]
  offlineEvents OfflineEvent[]

  // Makes the daily generator idempotent.
  @@unique([scheduleId, date])
  // Reports by date range.
  @@index([date])
  @@map("schedule_instances")
}

model AttendanceSession {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String            @map("student_id") @db.Uuid
  instanceId   String            @map("instance_id") @db.Uuid
  enteredAt    DateTime          @map("entrada") @db.Timestamptz()
  exitedAt     DateTime?         @map("salida") @db.Timestamptz()
  entrySource  AttendanceSource  @map("origen_entrada")
  exitSource   AttendanceSource? @map("origen_salida")
  status       SessionStatus     @default(abierta) @map("estado")
  manualReason String?           @map("motivo_manual")

  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instance      ScheduleInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  offlineEvents OfflineEvent[]

  @@index([instanceId, status])
  // Reports: sessions by entry date and by student within a date range.
  @@index([enteredAt])
  @@index([studentId, enteredAt])
  @@map("attendance_sessions")
}

model DeviceCommand {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId  String        @map("device_id")
  type      String        @map("tipo")
  payload   Json
  status    CommandStatus @default(pending) @map("estado")
  attempts  Int           @default(0) @map("intentos")
  // FIFO order for replaying pending commands after a reconnection.
  createdAt DateTime      @default(now()) @map("creada") @db.Timestamptz()

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Lookup of pending commands per device.
  @@index([deviceId, status])
  @@map("device_commands")
}

model ProcessedMessage {
  messageId  String   @map("message_id")
  deviceId   String   @map("device_id")
  receivedAt DateTime @default(now()) @map("recibido") @db.Timestamptz()
  response   Json?    @map("respuesta")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Idempotency key for repeated device messages.
  @@id([deviceId, messageId])
  @@map("processed_messages")
}

model AlarmEvent {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instanceId     String         @map("instance_id") @db.Uuid
  startedAt      DateTime       @map("inicio") @db.Timestamptz()
  endedAt        DateTime?      @map("fin") @db.Timestamptz()
  closedBy       AlarmClosedBy? @map("cerrada_por")
  // Open sessions marked no_registrada when the alarm was silenced manually.
  closedSessions Int            @default(0) @map("sesiones_cerradas")
  // H12: `local` rows come from a reader's offline queue and never drive the siren.
  origin         AlarmOrigin    @default(server)
  deviceId       String?        @map("device_id")
  deviceEventId  String?        @map("device_event_id") @db.Uuid

  instance      ScheduleInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  offlineEvents OfflineEvent[]

  @@index([instanceId])
  // Partial unique index (device_id, device_event_id) WHERE device_event_id IS NOT NULL
  // is added by hand in the h12_offline_tables migration.
  @@map("alarm_events")
}

// H12: roster a reader decided with. `roster` is {slot: studentId} (internal ids,
// no names, no biometrics). Purged after 14 days.
model OfflineSnapshot {
  id         String   @id @db.Uuid
  deviceId   String   @map("device_id")
  scheduleId String?  @map("schedule_id") @db.Uuid
  roster     Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("offline_snapshots")
}

// H12: every event a reader queued while offline, with what the server did with
// it. `outcome` is text + CHECK (pendiente, applied, por_revisar, aprobado,
// corregido, descartado, informativo, invalido).
model OfflineEvent {
  deviceId       String    @map("device_id")
  id             String    @db.Uuid
  seq            Int
  ts             DateTime  @db.Timestamptz()
  type           String
  slot           Int?
  snapshotId     String?   @map("snapshot_id") @db.Uuid
  batchId        String?   @map("batch_id") @db.Uuid
  studentId      String?   @map("student_id") @db.Uuid
  instanceId     String?   @map("instance_id") @db.Uuid
  outcome        String
  reviewReason   String?   @map("review_reason")
  sessionId      String?   @map("session_id") @db.Uuid
  alarmEventId   String?   @map("alarm_event_id") @db.Uuid
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz()
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz()
  resolution     String?
  resolutionNote String?   @map("resolution_note")
  correctedTs    DateTime? @map("corrected_ts") @db.Timestamptz()

  device     Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  student    Student?           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  instance   ScheduleInstance?  @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  session    AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  alarmEvent AlarmEvent?        @relation(fields: [alarmEventId], references: [id], onDelete: SetNull)
  resolver   PanelUser?         @relation(fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@id([deviceId, id])
  @@index([outcome, receivedAt])
  @@index([studentId, ts])
  @@map("offline_events")
}

model EventLog {
  id        Int       @id @default(autoincrement())
  type      String    @map("tipo")
  detail    Json?     @map("detalle")
  // Who originated the event: the admin key is `system`, a device message
  // is `device` with its id.
  actorType ActorType @default(system) @map("actor_type")
  actorId   String?   @map("actor_id")
  createdAt DateTime  @default(now()) @map("fecha") @db.Timestamptz()

  @@index([createdAt])
  @@map("event_log")
}

// Accounts of the web panel (H7). Passwords are only stored as argon2id hashes.
model PanelUser {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  username           String    @unique
  passwordHash       String    @map("password_hash")
  role               PanelRole
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz()
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  sessions              AuthSession[]
  consents              Student[]
  importBatches         ImportBatch[]
  resolvedOfflineEvents OfflineEvent[]

  @@map("panel_users")
}

// Revocable sessions of the panel; only the SHA-256 of the cookie token is stored.
model AuthSession {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz()
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz()

  user PanelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}
