# Copy to deploy/.env.production (never commit it) and replace every value.
# Generate secrets with: openssl rand -base64 32
# The compose file builds DATABASE_URL, NODE_ENV, PORT and TRUST_PROXY itself.

POSTGRES_USER=gymtime
POSTGRES_PASSWORD=
POSTGRES_DB=gymtime

# Key for the administration API / CLI (min 16 chars)
ADMIN_API_KEY=
# AES-256-GCM key of the fingerprint templates: base64 of exactly 32 bytes.
# BACK IT UP SEPARATELY from the database dumps (docs/runbook.md).
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
# After a rotation keep the old keys here: version:base64key,version:base64key
ENCRYPTION_KEYS_RETIRED=

# Transition only: shared reader token. Leave empty once every reader is
# registered with `gym device register` (docs/guia_wss_firmware.md).
DEVICE_TOKEN=

# Panel and API as sibling subdomains of your domain.
COOKIE_DOMAIN=.example.edu
COOKIE_SAMESITE=Strict
CORS_ORIGINS=https://app.example.edu

# Minutes a reader may stay offline before the alert (0 = disabled).
DEVICE_OFFLINE_ALERT_MINUTES=5

# Official consent text (JSON {version, text}); empty = provisional text.
CONSENT_FILE=

# /docs (Swagger) is off in production unless this is true.
ENABLE_DOCS=false
LOG_LEVEL=info

# First administrator, only while there are no accounts. Remove afterwards.
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=
