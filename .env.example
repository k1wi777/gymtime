# Copy to .env and replace every secret. Never commit .env.
# Generate secrets with: openssl rand -base64 32
#
# The example values below (change-me-*, gymtime_dev_password...) are for LOCAL
# DEVELOPMENT only. With NODE_ENV=production the server REFUSES to start if
# ADMIN_API_KEY, DEVICE_TOKEN, FIRST_ADMIN_PASSWORD, ENCRYPTION_KEY or the
# DATABASE_URL password keep an example value (change-me*, example, secret,
# password, dev-, test-, demo-..., repeated characters, empty password).

NODE_ENV=development
HOST=0.0.0.0
# 3000 by default. With the web panel on http://localhost:3000 use PORT=3001.
PORT=3000
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# PostgreSQL (shared by docker-compose.yml and the server)
POSTGRES_USER=gymtime
POSTGRES_PASSWORD=gymtime_dev_password
POSTGRES_DB=gymtime
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gymtime:gymtime_dev_password@localhost:5432/gymtime?schema=public

# Shared token the ESP32 presents when connecting (min 16 chars). Optional
# since H11: it only works for readers WITHOUT their own token (register each
# one with `gym device register <id>`) and is meant to be removed afterwards:
# once the real reader is registered, delete DEVICE_TOKEN and restart
# (docs/despliegue.md, docs/runbook.md). In production the server warns while it is set.
DEVICE_TOKEN=change-me-device-token
# Key for the administration API / CLI (min 16 chars)
ADMIN_API_KEY=change-me-admin-api-key
# AES-256-GCM key for fingerprint templates: base64 of exactly 32 bytes
ENCRYPTION_KEY=
# Version of ENCRYPTION_KEY (stored with every template) and the retired keys
# still needed to read older data: "version:base64key,version:base64key".
# Key rotation procedure: docs/runbook.md.
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_KEYS_RETIRED=

# Schedules: default entry window (minutes before start / before end) and how
# long before a schedule starts its templates are loaded into the reader
ENTRY_OPEN_MINUTES=10
ENTRY_CLOSE_MINUTES=5
SYNC_LEAD_MINUTES=15

# Alarm: short beep when a schedule ends empty (seconds) and how long after the
# end abandoned sessions are closed as no_registrada (minutes)
ALARM_BEEP_SECONDS=5
ALARM_TIMEOUT_MINUTES=30

# Reader TFT: text limits and default seconds a message stays on screen
DISPLAY_TITLE_MAX=32
DISPLAY_SUBTITLE_MAX=80
DISPLAY_SUBTITLE_LINES=2
DISPLAY_NAME_MAX=24
DISPLAY_RESULT_SECONDS=3

# --- Panel accounts and sessions (H7) ---
# The session is an httpOnly cookie named gt_session. No domain is hard-coded:
# everything below comes from the environment. See docs/autenticacion.md.
#
# Domain of the cookie. Empty = host-only (right for local development).
# In production, with panel and API as subdomains, use ".<your-domain>".
COOKIE_DOMAIN=
# Strict (default), Lax or None. None needs NODE_ENV=production (cookie Secure).
COOKIE_SAMESITE=Strict
# Origins allowed to call the API from a browser: exact scheme://host[:port],
# comma separated, no "*" and no path. Empty = no cross-origin access.
# Local: panel on http://localhost:3000, API on http://localhost:3001 (PORT=3001).
CORS_ORIGINS=http://localhost:3000
# Session ends after this many idle minutes or total hours since sign-in.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
# Account lock: failed attempts in a row, and minutes locked.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Sign-in attempts per IP and minute (answers 429 beyond it).
LOGIN_RATE_LIMIT=10
# Reverse-proxy hops to trust when reading the client IP (0 = none).
TRUST_PROXY=0
# Minutes a reader that had connected may stay offline before the alert
# (panel, audit trail, log). 0 disables it.
DEVICE_OFFLINE_ALERT_MINUTES=5

# Offline mode (H12): readers decide locally without a connection and the server
# reconciles their queue. Defaults shown; all optional.
# Seconds an event may be ahead of the server clock / hours it may be behind it
# before it goes to "Por revisar".
OFFLINE_TS_FUTURE_TOLERANCE_SEC=120
OFFLINE_TS_MAX_AGE_HOURS=72
# Seconds the roster snapshot waits for the queued events of a reconnecting reader.
OFFLINE_SNAPSHOT_WAIT_SEC=60
# Days a snapshot is kept to resolve late events.
OFFLINE_SNAPSHOT_RETENTION_DAYS=14
# |device clock - server clock| in seconds that raises the clock warning.
CLOCK_OFFSET_WARN_SEC=30
# Seconds between attempts of an instance to take the scheduler lock.
LEADER_RETRY_SECONDS=10
# JSON file {version, text} with the official consent text (see
# docs/consentimiento.ejemplo.json). Empty = the provisional text.
CONSENT_FILE=
# Publish /docs (Swagger UI) in production too. Off by default there.
ENABLE_DOCS=false
# First administrator, created at startup ONLY while there are no accounts.
# The password is temporary: it must be changed at the first sign-in. Remove
# both lines afterwards. Minimum 10 characters.
FIRST_ADMIN_USERNAME=
FIRST_ADMIN_PASSWORD=

# The future web panel (not in this repository yet) will read, in its own
# environment, the base URL of this API, e.g. http://localhost:3001:
# NEXT_PUBLIC_API_URL=
