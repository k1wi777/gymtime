# Copy to .env.local. Variables prefixed NEXT_PUBLIC_ are baked into the browser
# bundle at build time: never put a secret here.
#
# Base URL of the GymTime API, called directly by the browser (no proxy).
# Local development: the API runs on 3001 (PORT=3001) and the panel on 3000;
# the API must allow this panel origin in CORS_ORIGINS (http://localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:3001
