{
  "name": "@gymtime/cli",
  "version": "0.0.1",
  "description": "gym: administration CLI for the GymTime server",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "gym": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"vitest.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"vitest.config.ts\"",
    "lint": "oxlint --type-aware src/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
