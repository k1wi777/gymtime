{
  "name": "@gymtime/shared",
  "version": "0.0.1",
  "description": "GymTime protocol schemas and shared types",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"vitest.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"vitest.config.ts\"",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
